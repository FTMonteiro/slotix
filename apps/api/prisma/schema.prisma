generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OWNER
  EMPLOYEE
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Domain-only for now (see Payment model doc comment): no gateway is wired up yet, so
// these just describe how the money moved, recorded after the fact.
enum PaymentMethod {
  CASH
  CARD
  MULTICAIXA
  BANK_TRANSFER
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedBusinesses    Business[]     @relation("BusinessOwner")
  professionalProfile Professional?
  appointments       Appointment[]  @relation("AppointmentClient")
  refreshTokens      RefreshToken[]
  favorites          Favorite[]
  reviews            Review[]
  notifications      Notification[]
  payments           Payment[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Business {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  name        String
  description String?
  address     String?
  phone       String?
  category    String?
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  favorites     Favorite[]
  reviews       Review[]
  hours         BusinessHours[]
  payments      Payment[]

  @@index([ownerId])
  @@map("businesses")
}

// One row per open window; a day with no rows is closed, and a day can have several
// rows (e.g. 09:00-13:00 + 14:00-18:00) to represent a lunch break as a gap.
model BusinessHours {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes since midnight, e.g. 540 = 09:00
  endMinute   Int // e.g. 1080 = 18:00
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, dayOfWeek])
  @@map("business_hours")
}

model Professional {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  bio        String?
  specialty  String?
  imageUrl   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  appointments Appointment[]
  blocks       ProfessionalBlock[]

  @@index([businessId])
  @@map("professionals")
}

// Time off / vacation / anything that takes a professional out of availability
// without cancelling actual appointments (those are already excluded separately).
model ProfessionalBlock {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([professionalId, startAt])
  @@map("professional_blocks")
}

model Service {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  category    String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@index([businessId])
  @@map("services")
}

model Appointment {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String
  client         User              @relation("AppointmentClient", fields: [clientId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id])
  scheduledAt    DateTime
  durationMinutes Int
  price          Decimal           @db.Decimal(10, 2)
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  review  Review?
  payment Payment?

  @@index([businessId])
  @@index([clientId])
  @@index([professionalId, scheduledAt])
  @@map("appointments")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("favorites")
}

model Review {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId      String
  client        User        @relation(fields: [clientId], references: [id])
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId])
  @@map("reviews")
}

// One payment per appointment (appointmentId is unique): a PENDING payment moves through
// PAID/FAILED/REFUNDED as status transitions rather than spawning new rows, so the
// original record — and its history — is never lost. amount/currency/userId/businessId
// are always derived server-side from the appointment; never accept them from a client.
model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("AOA")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([businessId])
  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}
